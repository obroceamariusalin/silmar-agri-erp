# Copiază acest fișier în backend/.env și completează valorile.
# Pe Render setează aceleași variabile în Dashboard -> Environment.

# Cheie pentru semnarea sesiunilor (obligatoriu în producție). Generează una cu:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Contul de administrator creat automat la prima pornire (dacă nu există niciun utilizator)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NUME=Administrator

# Durata sesiunii în ore (implicit 7 zile)
SESSION_HOURS=168

# Lasă gol local (se folosește SQLite: backend/sql_app.db). Pe Render e setat automat de baza PostgreSQL.
DATABASE_URL=

# Cloudinary (dacă lipsesc, se folosesc valorile existente din config.py)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cota de arendă (kg/ha)
KG_PER_HA=600
